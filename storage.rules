rules_version = '2';

// Who may read and write files in Firebase Storage. Roles come from the user's
// Firestore profile (users/{uid}), the same as firestore.rules. Keep both in sync.
// Publish in the Firebase console: Storage > Rules. The console asks once to let
// Storage read Firestore; allow it.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return request.auth != null && profile().active == true && profile().role in roles;
    }

    // Largest file per kind: video and audio up to 200 MB, everything else up to 25 MB.
    function sizeOk() {
      return request.resource.size <= 25 * 1024 * 1024
        || (request.resource.contentType.matches('(video|audio)/.*') && request.resource.size <= 200 * 1024 * 1024);
    }

    // Sales gallery: gallery/sales/{fileId}/{file name}, plus a thumbnail next to it.
    match /gallery/sales/{fileId}/{name} {
      allow read: if hasRole(['admin', 'project_manager', 'hr_manager', 'sales', 'staff', 'investor', 'viewer']);
      allow create, update: if hasRole(['admin', 'sales']) && sizeOk();
      allow delete: if hasRole(['admin', 'sales']);
    }

    // Project files: projects/{projectId}/{assetId}/{file name}. The team can open them;
    // admins and project managers add and delete them.
    match /projects/{projectId}/{assetId}/{name} {
      allow read: if hasRole(['admin', 'project_manager', 'hr_manager', 'sales', 'staff', 'investor', 'viewer']);
      allow create, update: if hasRole(['admin', 'project_manager']) && sizeOk();
      allow delete: if hasRole(['admin', 'project_manager']);
    }

    // Screenshots in case studies: documents/{docId}/{file}. Shared documents show them by their
    // download link; in the app, the sales team uploads and removes them.
    match /documents/{docId}/{name} {
      allow read: if hasRole(['admin', 'project_manager', 'sales']);
      allow create, update: if hasRole(['admin', 'sales']) && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasRole(['admin', 'sales']);
    }

    // Signed copies the client sent back (PDF, scan or photo): documents/{docId}/signed/{file}.
    // Only inside the app; never part of a shared link.
    match /documents/{docId}/signed/{name} {
      allow read: if hasRole(['admin', 'project_manager', 'sales']);
      allow create, update: if hasRole(['admin', 'sales']) && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if hasRole(['admin', 'sales']);
    }

    // Nothing else is stored.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
