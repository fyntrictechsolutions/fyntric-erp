rules_version = '2';

// Server-side access control for Fyntric ERP.
// Mirrors the permission matrix in src/config/roles.ts. Change both together
// (see docs/roles-and-permissions.md). Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(profilePath()).data;
    }

    // The caller's role, or "none" if signed out, not registered, or disabled.
    function role() {
      return signedIn() && exists(profilePath()) && me().active == true ? me().role : 'none';
    }

    function hasRole(roles) {
      return role() in roles;
    }

    // Fyntric employees (not clients, investors or viewers).
    function internal() {
      return hasRole(['admin', 'project_manager', 'hr_manager', 'sales', 'staff']);
    }

    // ---------- Record helpers ----------

    function isOwner() {
      return resource.data.userId == request.auth.uid;
    }

    // New records must be stamped with the creator's own uid.
    function createsOwn() {
      return request.resource.data.userId == request.auth.uid;
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Ownership fields can never be rewritten.
    function keepsOwner() {
      return unchanged(['userId', 'userName', 'employeeId', 'createdBy', 'createdAt']);
    }

    // A client user reading records linked to their company.
    function isMyClientRecord() {
      return role() == 'client' && me().clientId != null && resource.data.clientId == me().clientId;
    }

    // ---------- Collections ----------

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'admin');
      // First sign-in registers the user as "pending" until an admin assigns a role...
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.active == true
        && !('employeeId' in request.resource.data) && !('clientId' in request.resource.data);
      // ...or takes the role, client and employee link from an admin's invitation for their verified email.
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.active == true
        && request.resource.data.inviteId == request.auth.token.email.lower()
        && invitationMatches(request.resource.data);
      // Admins manage everyone, but can't change their own role or disable themselves.
      allow update: if role() == 'admin' && (uid != request.auth.uid || unchanged(['role', 'active']));
      // Anyone can update their own name and photo.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if role() == 'admin' && uid != request.auth.uid;
    }

    function invitePath(id) {
      return /databases/$(database)/documents/invites/$(id);
    }

    function invitationMatches(data) {
      let invite = get(invitePath(data.inviteId)).data;
      return exists(invitePath(data.inviteId))
        && data.role == invite.role
        && data.get('clientId', null) == invite.get('clientId', null)
        && data.get('employeeId', null) == invite.get('employeeId', null);
    }

    // Invitations, keyed by email in lower case. The invited person can read and clear their own.
    match /invites/{id} {
      allow read, write: if role() == 'admin';
      // HR can invite a hired candidate, only as Other Staff.
      allow get: if role() == 'hr_manager';
      allow create, update: if role() == 'hr_manager'
        && request.resource.data.role == 'staff'
        && request.resource.data.get('clientId', null) == null
        && (resource == null || resource.data.role == 'staff');
      allow get, delete: if signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == id;
    }

    // Activity log: anyone signed in adds entries stamped with their own account and the server's time.
    // Nobody can change or delete an entry, so the log can be trusted. Only admins read it.
    match /logs/{id} {
      allow read: if role() == 'admin';
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action in ['login', 'logout', 'session', 'create', 'update', 'delete']
        && request.resource.data.changes is list
        && request.resource.data.changes.size() <= 40;
      allow update, delete: if false;
    }

    // Company settings: everyone signed in reads them, admins change them.
    match /settings/{section} {
      allow read: if !hasRole(['none', 'pending']);
      allow write: if role() == 'admin';
    }

    // HR

    match /employees/{id} {
      allow read: if hasRole(['admin', 'hr_manager', 'project_manager', 'investor', 'viewer']);
      // HR creates the record when a candidate joins; only admins edit it afterwards.
      allow create: if hasRole(['admin', 'hr_manager']) && createsOwn();
      allow update: if role() == 'admin' && keepsOwner();
      allow delete: if role() == 'admin';
    }

    match /attendance/{id} {
      allow read: if hasRole(['admin', 'hr_manager', 'project_manager', 'investor', 'viewer']) || (internal() && isOwner());
      allow create: if internal() && createsOwn();
      allow update: if keepsOwner() && (
        hasRole(['admin', 'project_manager'])
        // Staff can check out once; they can't move their check-in or edit the day afterwards.
        || (internal() && isOwner() && resource.data.get('checkOut', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'hours', 'notes', 'updatedAt']))
      );
      allow delete: if role() == 'admin';
    }

    match /leave/{id} {
      allow read: if hasRole(['admin', 'hr_manager', 'project_manager', 'investor', 'viewer']) || (internal() && isOwner());
      allow create: if createsOwn() && (
        hasRole(['admin', 'hr_manager'])
        || (internal() && request.resource.data.status == 'pending')
      );
      allow update: if keepsOwner() && (
        hasRole(['admin', 'hr_manager'])
        // Staff can edit their own request while it's pending, but can't approve it.
        || (internal() && isOwner() && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && unchanged(['reviewNote', 'reviewedBy']))
      );
      allow delete: if hasRole(['admin', 'hr_manager'])
        || (internal() && isOwner() && resource.data.status == 'pending');
    }

    // Hiring, salaries and exits: HR's own records.

    match /candidates/{id} {
      allow read: if hasRole(['admin', 'hr_manager']);
      allow create: if hasRole(['admin', 'hr_manager']) && createsOwn();
      allow update: if hasRole(['admin', 'hr_manager']) && keepsOwner();
      allow delete: if hasRole(['admin', 'hr_manager']);
    }

    // One document per employee: current structure plus history.
    match /salaries/{employeeId} {
      allow read, write: if hasRole(['admin', 'hr_manager']);
    }

    // Payslips, one per employee per month. People see their own once paid.
    match /payroll/{id} {
      allow read: if hasRole(['admin', 'hr_manager'])
        || (internal() && resource.data.accountId == request.auth.uid && resource.data.status == 'paid');
      allow create: if hasRole(['admin', 'hr_manager']) && createsOwn();
      allow update: if hasRole(['admin', 'hr_manager']) && keepsOwner();
      allow delete: if hasRole(['admin', 'hr_manager']);
    }

    match /exits/{employeeId} {
      allow read, write: if hasRole(['admin', 'hr_manager']);
      // An employee sees their own resignation...
      allow read: if isMyEmployee(employeeId);
      // ...submits one (new, or again after withdrawing), with the 24-hour cool-off it promises...
      allow create: if isMyEmployee(employeeId) && selfResignation(employeeId);
      allow update: if isMyEmployee(employeeId) && resource.data.status == 'withdrawn' && selfResignation(employeeId);
      // ...takes it back during the cool-off without a trace...
      allow delete: if isMyEmployee(employeeId) && resource.data.source == 'self' && resource.data.status == 'requested'
        && request.time.toMillis() < resource.data.sendAt;
      // ...or withdraws it after that, until HR starts processing it.
      allow update: if isMyEmployee(employeeId) && resource.data.source == 'self' && resource.data.status == 'requested'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnOn', 'withdrawnBy', 'updatedAt']);
    }

    function isMyEmployee(employeeId) {
      return internal() && me().get('employeeId', null) == employeeId;
    }

    function selfResignation(employeeId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['employeeId', 'employeeName', 'status', 'source', 'receivedOn', 'requestedLastDay', 'reason', 'userId', 'userName', 'submittedAt', 'sendAt', 'createdAt', 'updatedAt'])
        && d.employeeId == employeeId && d.status == 'requested' && d.source == 'self' && d.userId == request.auth.uid
        && d.sendAt is int && d.sendAt >= request.time.toMillis() + 86000000;
    }

    // Small attachments (certificates, signed letters) kept in Firestore; HR documents only for now.
    match /files/{id} {
      allow read, delete: if hasRole(['admin', 'hr_manager']);
      allow create: if hasRole(['admin', 'hr_manager']) && createsOwn()
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    // Sales

    match /leads/{id} {
      allow read: if hasRole(['admin', 'sales', 'project_manager', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if hasRole(['admin', 'sales']);
    }

    match /followups/{id} {
      allow read: if hasRole(['admin', 'sales', 'project_manager', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if hasRole(['admin', 'sales']);
    }

    match /estimates/{id} {
      allow read: if hasRole(['admin', 'sales', 'project_manager', 'investor', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if hasRole(['admin', 'sales']);
    }

    match /clients/{id} {
      allow read: if hasRole(['admin', 'sales', 'project_manager', 'investor', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if hasRole(['admin', 'sales']);
    }

    // Galleries: one collection for every gallery, told apart by `gallery` ("sales" for now).
    // The files themselves are on Cloudinary; this is their list, names and product links.
    match /gallery/{id} {
      allow read: if resource.data.gallery == 'sales' && (internal() || hasRole(['investor', 'viewer']));
      allow create: if request.resource.data.gallery == 'sales' && hasRole(['admin', 'sales']) && createsOwn();
      allow update: if resource.data.gallery == 'sales' && request.resource.data.gallery == 'sales'
        && hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if resource.data.gallery == 'sales' && hasRole(['admin', 'sales']);
    }

    match /products/{id} {
      allow read: if internal() || hasRole(['investor', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if hasRole(['admin', 'sales']);
    }

    // Delivery

    match /projects/{id} {
      allow read: if internal() || hasRole(['investor', 'viewer']) || isMyClientRecord();
      allow create: if hasRole(['admin', 'project_manager']) && createsOwn();
      allow update: if hasRole(['admin', 'project_manager']) && keepsOwner();
      allow delete: if hasRole(['admin', 'project_manager']);
    }

    match /timesheets/{id} {
      allow read: if hasRole(['admin', 'project_manager']) || (internal() && isOwner());
      allow create: if internal() && createsOwn();
      allow update: if keepsOwner() && (hasRole(['admin', 'project_manager']) || (internal() && isOwner()));
      allow delete: if hasRole(['admin', 'project_manager']) || (internal() && isOwner());
    }

    // Purchases (admin keeps the books; investors and viewers can look)

    match /suppliers/{id} {
      allow read: if hasRole(['admin', 'investor', 'viewer']);
      allow create: if role() == 'admin' && createsOwn();
      allow update: if role() == 'admin' && keepsOwner();
      allow delete: if role() == 'admin';
    }

    match /purchases/{id} {
      allow read: if hasRole(['admin', 'investor', 'viewer']);
      allow create: if role() == 'admin' && createsOwn();
      allow update: if role() == 'admin' && keepsOwner();
      allow delete: if role() == 'admin';
    }

    // Finance

    match /invoices/{id} {
      allow read: if hasRole(['admin', 'sales', 'project_manager', 'hr_manager', 'investor', 'viewer']) || isMyClientRecord();
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if role() == 'admin';
    }

    // Recurring charges (AMC, hosting): whoever raises invoices keeps the schedule.
    match /recurring/{id} {
      allow read: if hasRole(['admin', 'sales', 'investor', 'viewer']);
      allow create: if hasRole(['admin', 'sales']) && createsOwn();
      allow update: if hasRole(['admin', 'sales']) && keepsOwner();
      allow delete: if role() == 'admin';
    }

    match /payments/{id} {
      allow read: if hasRole(['admin', 'sales', 'investor', 'viewer']);
      // Sales staff record money received against invoices; only admins record money paid out.
      allow create: if createsOwn() && (
        role() == 'admin'
        || (role() == 'sales' && request.resource.data.direction == 'received')
      );
      allow update: if role() == 'admin' && keepsOwner();
      allow delete: if role() == 'admin';
    }

    match /expenses/{id} {
      allow read: if hasRole(['admin', 'investor', 'viewer']) || (internal() && isOwner())
        || (role() == 'hr_manager' && resource.data.source == 'payroll');
      allow create: if createsOwn() && (
        role() == 'admin'
        || (internal() && request.resource.data.status == 'pending')
        || (role() == 'hr_manager' && isPayrollExpense(id))
      );
      allow update: if (keepsOwner() && (
        role() == 'admin'
        || (internal() && isOwner() && resource.data.status == 'pending'
            && request.resource.data.status == 'pending')
      ))
        // HR's payroll keeps one "Salaries" expense per month in step with the paid payslips.
        || (role() == 'hr_manager' && resource.data.source == 'payroll' && isPayrollExpense(id));
      allow delete: if role() == 'admin'
        || (internal() && isOwner() && resource.data.status == 'pending')
        || (role() == 'hr_manager' && resource.data.source == 'payroll');
    }

    function isPayrollExpense(id) {
      return request.resource.data.source == 'payroll'
        && request.resource.data.category == 'Salaries'
        && id == 'payroll-' + request.resource.data.month;
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
